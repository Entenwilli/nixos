{...}: {
  flake.nixosModules.adventurelog = {
    pkgs,
    lib,
    config,
    ...
  }: {
    options.adventurelog.enable = lib.mkEnableOption "Enable adventurelog";

    config = lib.mkIf config.adventurelog.enable {
      sops.secrets."adventurelog-env" = {
        restartUnits = [
          "docker-adventurelog-app.service"
          "docker-adventurelog-db.service"
        ];
      };

      services.traefik.dynamicConfigOptions = {
        http = {
          services.adventurelogService.loadBalancer.servers = [
            {
              url = "http://127.0.0.1:8015";
            }
          ];
          routers.adventurelogRouter = {
            entryPoints = ["websecure"];
            rule = "Host(`travel.fschwickerath.de`)";
            service = "adventurelogService";
            tls.certResolver = "resolver";
            middlewares = ["chainNoAuth"];
          };
        };
      };

      virtualisation.docker = {
        enable = true;
        autoPrune.enable = true;
      };
      virtualisation.oci-containers.backend = "docker";

      virtualisation.oci-containers.containers."adventurelog-db" = {
        image = "postgis/postgis:16-3.5";
        pull = "always";
        environment = {
          "POSTGRES_DB" = "database";
          "POSTGRES_USER" = "adventure";
        };
        environmentFiles = [config.sops.secrets."adventurelog-env".path];
        volumes = [
          "/srv/data/adventurelog/database:/var/lib/postgresql/data:rw"
        ];
        log-driver = "journald";
        extraOptions = [
          "--health-cmd=pg_isready -U adventure -d database"
          "--health-interval=5s"
          "--health-timeout=5s"
          "--health-retries=5"
          "--health-start-period=10s"
          "--network-alias=db"
          "--network=adventurelog"
        ];
      };
      systemd.services."docker-adventurelog-db" = {
        serviceConfig = {
          Restart = lib.mkOverride 90 "always";
          RestartMaxDelaySec = lib.mkOverride 90 "1m";
          RestartSec = lib.mkOverride 90 "100ms";
          RestartSteps = lib.mkOverride 90 9;
        };
        after = ["docker-network-adventurelog.service"];
        requires = ["docker-network-adventurelog.service"];
        partOf = ["docker-compose-adventurelog-root.target"];
        wantedBy = ["docker-compose-adventurelog-root.target"];
      };

      virtualisation.oci-containers.containers."adventurelog-app" = {
        image = "ghcr.io/seanmorley15/adventurelog:latest";
        pull = "always";
        environment = {
          "SITE_URL" = "https://travel.fschwickerath.de";
          "PGHOST" = "db";
          "POSTGRES_DB" = "database";
          "POSTGRES_USER" = "adventure";
          "DEBUG" = "False";
          "ENABLE_RATE_LIMITS" = "False";
          "DISABLE_REGISTRATION" = "True";
        };
        environmentFiles = [config.sops.secrets."adventurelog-env".path];
        volumes = [
          "/srv/data/adventurelog/media:/code/media/:rw"
        ];
        dependsOn = ["adventurelog-db"];
        log-driver = "journald";
        ports = ["127.0.0.1:8015:80"];
        extraOptions = [
          "--health-cmd=python3 -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:80/health')\""
          "--health-interval=30s"
          "--health-timeout=5s"
          "--health-retries=5"
          "--health-start-period=120s"
          "--network-alias=app"
          "--network=adventurelog"
        ];
      };
      systemd.services."docker-adventurelog-app" = {
        serviceConfig = {
          Restart = lib.mkOverride 90 "always";
          RestartMaxDelaySec = lib.mkOverride 90 "1m";
          RestartSec = lib.mkOverride 90 "100ms";
          RestartSteps = lib.mkOverride 90 9;
        };
        after = ["docker-network-adventurelog.service"];
        requires = ["docker-network-adventurelog.service"];
        partOf = ["docker-compose-adventurelog-root.target"];
        wantedBy = ["docker-compose-adventurelog-root.target"];
      };

      systemd.services."docker-network-adventurelog" = {
        path = [pkgs.docker];
        serviceConfig = {
          Type = "oneshot";
          RemainAfterExit = true;
          ExecStop = "docker network rm -f adventurelog";
        };
        script = ''
          docker network inspect adventurelog || docker network create adventurelog --driver=bridge
        '';
        partOf = ["docker-compose-adventurelog-root.target"];
        wantedBy = ["docker-compose-adventurelog-root.target"];
      };

      systemd.targets."docker-compose-adventurelog-root" = {
        unitConfig = {
          Description = "Root target generated by compose2nix.";
        };
        wantedBy = ["multi-user.target"];
      };

      services.borgbackup.jobs.backup.paths = ["/srv/data/adventurelog/"];
    };
  };
}
